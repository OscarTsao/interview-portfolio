---
const {title='曹喻寧 Yu-Ning Tsao — AI / ML & Software Engineering',description='曹喻寧 Yu-Ning Tsao 的工程與研究作品：BitoGuard 的 ML 與 AWS 部署、HiED 碩士論文，以及 Web 互動作品。',image=null,noindex=false}=Astro.props;
const base=import.meta.env.BASE_URL;
const canonical=new URL(Astro.url.pathname,Astro.site);
const preview=image?new URL(image.startsWith('/')?image:base+image,Astro.site):null;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
  <link rel="icon" type="image/svg+xml" href={base+'favicon.svg'}/>
  <meta name="description" content={description}/>{noindex?<meta name="robots" content="noindex,follow"/>:<link rel="canonical" href={canonical}/>}
  <meta property="og:type" content="website"/><meta property="og:locale" content="zh_TW"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
  {!noindex&&<meta property="og:url" content={canonical}/>} {preview&&<meta property="og:image" content={preview}/>}
  <meta name="twitter:card" content={preview?"summary_large_image":"summary"}/><title>{title}</title>
</head>
<body>
  <a class="skip" href="#main">跳到主要內容</a>
  <header class="site-header">
    <a class="wordmark" href={base}>Yu-Ning Tsao<span>Software · ML · Cloud</span></a>
    <nav aria-label="主要導覽"><a href={base+'#work'}>作品</a><a href={base+'#about'}>關於我</a><a href={base+'#contact'}>聯絡</a></nav>
  </header>
  <main id="main"><slot/></main>
  <footer class="site-footer"><span>© {new Date().getFullYear()} Yu-Ning Tsao</span><span>工程與研究作品集</span></footer>
</body>
</html>
<style is:global>
.case-grid > * { min-width: 0; }
:root{--canvas:#f6f8fc;--surface:#fff;--ink:#0f172a;--muted:#475569;--primary:#1d4ed8;--primary-hover:#1e40af;--tint:#eaf1ff;--border:#cbd5e1;--control:#64748b;font-family:system-ui,-apple-system,"Segoe UI","Noto Sans TC","PingFang TC","Microsoft JhengHei",sans-serif;color:var(--ink);background:var(--canvas);line-height:1.75;scroll-behavior:smooth}
*{box-sizing:border-box}body{margin:0}[hidden]{display:none!important}a{color:inherit;text-underline-offset:5px;overflow-wrap:anywhere}a:hover{color:var(--primary)}.site-header,main,.site-footer{max-width:1168px;margin:auto;padding-left:24px;padding-right:24px}.site-header{min-height:96px;display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid var(--border)}.wordmark{font-weight:750;font-size:20px;text-decoration:none;letter-spacing:-.4px}.wordmark span{display:block;font-size:12px;letter-spacing:.6px;font-weight:500;color:var(--muted)}nav{display:flex;gap:28px;font-size:15px}nav a{text-decoration:none;min-height:44px;display:inline-flex;align-items:center}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(38px,4.8vw,60px);line-height:1.2;letter-spacing:-1.6px}h2{font-size:30px;letter-spacing:-.7px;line-height:1.4}h3{font-size:23px;line-height:1.4;letter-spacing:-.4px}p{color:var(--muted)}.eyebrow{color:var(--primary);font-size:12px;font-weight:750;letter-spacing:1.6px;margin-bottom:14px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:10px 20px;background:var(--primary);color:white;border-radius:8px;text-decoration:none;font-size:15px;font-weight:650}.button:hover{background:var(--primary-hover);color:white}.links{display:flex;align-items:center;flex-wrap:wrap;gap:12px 24px;font-size:15px;font-weight:600}.links>a{min-height:44px;display:inline-flex;align-items:center}.tag,.muted{font-size:14px;color:var(--muted)}.section-title{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:28px}.section-title h2{margin-bottom:0}.section-title p{font-size:15px;margin:0}.section-title .eyebrow{font-size:12px;margin-bottom:8px}.section{padding:56px 0;border-top:1px solid var(--border)}.preview-image{width:100%;height:auto;display:block;border:1px solid var(--border);border-radius:12px}.case-hero{padding:32px 0 36px;max-width:880px}.case-hero h1{margin-bottom:20px}.case-hero>p:not(.eyebrow){font-size:18px;max-width:760px}.case-grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:48px;padding:44px 0 70px}.case-meta{font-size:14px;color:var(--muted)}.case-meta dt{color:var(--ink);font-weight:700;margin-bottom:5px}.case-meta dd{margin:0 0 22px}.prose{max-width:730px;font-size:16px}.prose h2{font-size:25px;margin-top:32px}.prose h2:first-child{margin-top:0}.prose h3{font-size:20px;margin:24px 0 8px}.prose li{color:var(--muted);margin:9px 0}.note{padding:18px 20px;background:var(--tint);border-left:3px solid var(--primary);border-radius:0 8px 8px 0;font-size:15px;color:var(--muted)}.back{min-height:44px;display:inline-flex;align-items:center;margin-top:26px;font-size:14px;text-decoration:none}.skip{position:absolute;top:-100px;left:12px;background:var(--primary);color:#fff;padding:10px;z-index:20}.skip:focus{top:10px}:focus-visible{outline:3px solid var(--primary);outline-offset:4px}.site-footer{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:24px;padding-bottom:28px;font-size:13px;color:var(--muted)}img{max-width:100%}section[id]{scroll-margin-top:24px}button,select,input{font:inherit}button{cursor:pointer}button:disabled{cursor:wait;opacity:.65}summary{cursor:pointer;padding:12px 0;font-weight:650}.step-list li{padding-left:5px;margin:12px 0}.table-wrap{overflow:auto;max-width:100%;margin:24px 0}table{width:100%;border-collapse:collapse;min-width:540px;font-size:14px}th,td{text-align:left;vertical-align:top;padding:12px;border-bottom:1px solid var(--border)}th{color:var(--ink)}.text-link{font-weight:650}.case-nav{display:flex;gap:10px 24px;flex-wrap:wrap;margin:20px 0}.case-nav a{min-height:44px;display:inline-flex;align-items:center;font-size:14px}.method-flow{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.method-flow li{padding:16px;background:var(--tint);border:1px solid var(--border);border-radius:8px}.method-flow strong{display:block;color:var(--ink)}.method-flow span{font-size:14px}.caption{font-size:14px;margin-top:12px;color:var(--muted)}
@media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}*{transition:none!important}}
@media(max-width:720px){.site-header,main,.site-footer{padding-left:20px;padding-right:20px}.site-header{min-height:84px;gap:12px;flex-wrap:wrap;padding-top:14px;padding-bottom:14px}.wordmark{font-size:18px}.wordmark span{font-size:11px}nav{gap:18px;font-size:14px}h1{letter-spacing:-1px}h2{font-size:26px}.section{padding:40px 0}.section-title{display:block}.section-title>p{margin-top:10px}.case-hero{padding-top:26px}.case-hero>p:not(.eyebrow){font-size:16px}.case-grid{grid-template-columns:1fr;gap:20px;padding-top:28px}.case-meta dd{margin-bottom:16px}.method-flow{grid-template-columns:1fr}}
</style>
