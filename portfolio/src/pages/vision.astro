---
import Site from '../layouts/Site.astro';
import SegmentationArchive from '../components/SegmentationArchive.astro';
const base = import.meta.env.BASE_URL;
---
<Site title={import.meta.env.DEV?'TVST 研究脈絡 — PCV 分割結果與標註':'TVST 研究脈絡 — PCV 分割方法與來源'} description="理解 FA 影像中的 PCV 分割任務、封存模型比較與研究貢獻；研究影像僅於本機展示。">
<a class="back" href={base+'projects/vision/'}>← 回到研究介紹</a>
<section class="case-hero">
  <p class="eyebrow">OPHTHALMIC IMAGING / PCV SEGMENTATION</p>
  <h1>{import.meta.env.DEV?<>PCV 病灶分割，<br/>從標註到模型結果。</>:<>從 FA 影像，<br/>理解病灶分割。</>}</h1>
  <p>{import.meta.env.DEV?'從原圖、參考標註到封存模型預測，逐層查看病灶範圍；再比較後處理如何改變結果。研究簡報的模型比較與失敗案例另保留來源說明。':'TVST 研究關注 PCV 病灶的分割與定位。這裡說明研究任務、我的貢獻與資料來源；封存結果及標註的互動比較於本機提供。'}</p>
  <div class="links"><a href="https://doi.org/10.1167/tvst.14.10.15" target="_blank" rel="noopener noreferrer">閱讀 TVST 論文 ↗</a>{import.meta.env.DEV&&<a href="#pixel-comparison">查看逐像素比較 ↓</a>}<a href="#source">展示來源與限制 ↓</a></div>
</section>
<SegmentationArchive/>
<section id="pixel-comparison" class="seg-viewer" aria-label="PCV 病灶分割比較">
  <div class="viewer-heading"><div><p class="eyebrow">IMAGE · REFERENCE · PREDICTION</p><h2>同一影像，逐層比較</h2></div><span class="badge">{import.meta.env.DEV?'本機研究預覽':'公開研究說明'}</span></div>
  <p class="scope">{import.meta.env.DEV?'可切換原始尺寸標註，以及 224 × 224 的參考標註、封存預測與後處理遮罩。':'公開版保留研究方法與來源說明；影像與逐像素比較於本機展示。'}參考標註<strong>不是模型預測</strong>；封存輸出與最終論文案例的對應仍待確認。</p>
  <fieldset id="seg-controls" disabled hidden={!import.meta.env.DEV}>
    <legend class="sr-only">影像與分割圖層控制</legend>
    <div class="field"><label for="seg-case">選擇影像</label><select id="seg-case"><option>載入中…</option></select></div>
    <div class="field"><label for="seg-layer">分割圖層</label><select id="seg-layer"><option value="native">參考標註 · 原始尺寸</option><option value="reference">參考標註 · 模型尺寸</option><option value="prediction">封存模型預測</option><option value="processed">後處理結果</option></select></div>
    <div class="field"><label for="mask-mode">檢視方式</label><select id="mask-mode"><option value="overlay">紅色疊圖</option><option value="mask">二值遮罩</option></select></div>
    <label class="check"><input id="mask-visible" type="checkbox" checked/> 顯示遮罩</label>
    <div class="field opacity-field"><label for="opacity">疊圖不透明度 <output id="opacity-value" for="opacity">45%</output></label><input id="opacity" type="range" min="0" max="100" value="45"/></div>
    <button id="seg-reset" type="button">重設檢視</button>
  </fieldset>
  <p id="seg-status" role="status">{import.meta.env.DEV?'正在載入原圖與標註…':'公開版提供研究方法與來源說明；研究影像與紅色病灶標註僅於本機展示。'}</p><button id="seg-retry" type="button" hidden>重新載入</button>
  <div id="seg-content" hidden aria-busy="true">
    <div class="image-pair">
      <figure><figcaption><strong id="input-title">FA 原圖</strong><span id="input-description">儲存庫中的影像，保留原始尺寸</span></figcaption><canvas id="original-canvas" role="img" aria-label="所選 FA 原圖"></canvas></figure>
      <figure><figcaption><strong id="mask-title">參考標註疊圖</strong><span id="mask-legend"><i aria-hidden="true"></i>紅色：資料集標註區域</span></figcaption><canvas id="seg-canvas" role="img" aria-label="FA 原圖與病灶參考標註疊圖"></canvas></figure>
    </div>
    <div id="seg-metrics" hidden>
      <dl class="scores"><div><dt>預測 Dice</dt><dd id="prediction-dice"></dd></div><div><dt>後處理 Dice</dt><dd id="processed-dice"></dd></div></dl>
      <p id="seg-observation"></p>
      <p class="metric-caption">Dice 衡量預測與參考標註的重疊程度，1 表示完全重疊。數值由此影像的二值遮罩重算，並核對封存紀錄；單一案例不代表整體模型成效。</p>
    </div>
    <div class="viewer-footer"><p id="dimensions"></p><a id="seg-link" href="?case=seg-01">此影像連結 →</a></div>
  </div>
  <noscript><p>互動疊圖需要 JavaScript。下方仍可閱讀研究任務與資料來源。</p></noscript>
</section>
<section class="prediction-note" aria-labelledby="prediction-title">
  <div><p class="eyebrow">POST-PROCESSING</p><h2 id="prediction-title">保留最大區域，也可能刪掉病灶</h2></div>
  <p>封存的後處理保留最大的連通區域，去除分散的小區塊。三個既有案例分別呈現 Dice 下降、不變與上升：減少零碎預測有時也會移除正確區域，不能假設後處理一定改善結果。</p>
  <p>本機比較使用 NAS 找回的<strong>獨立參考標註、預測及後處理遮罩</strong>，維持原始檔案；不是由彩色疊圖反推。這些是儲存的實驗輸出，與最終 TVST 論文的逐案對應尚未確認。</p>
</section>
<section id="source" class="section source">
  <div><p class="eyebrow">TASK &amp; PROVENANCE</p><h2>理解分割，也看清證據。</h2><p>參考標註說明模型需要找出的區域；模型比較圖則呈現預測的重疊與誤差。展示同時保留改善與失敗情境，不以挑選案例推論整體效果。</p><p>我在相關 TVST 論文為第二作者，負責影像後處理，並參與跨院資料整理、研究討論與撰寫。</p></div>
  <div><h3>本次資料</h3><ul><li>模型比較：NAS 封存的 <code>Handover_images.pptx</code>，第 3、4、10 頁；影像保留原位元組，Dice 按來源簡報記錄。</li><li>原始尺寸標註：Handover_Self-supervised，版本 <code>344cd81</code> 的三組 test 影像與 mask。</li><li>逐像素預測：Handover Linux 研究封存的三組 224 × 224 輸出。輸入及標註與原始尺寸資料最近鄰縮放後逐像素一致；Dice 由遮罩重算，吻合來源紀錄。</li><li>簡報比較與互動遮罩不是同一批展示影像；均未逐案確認與最終 TVST 論文的對應。</li><li>互動遮罩為 0／255 二值資料；紅色疊圖不修改來源檔案。私人影像僅於本機提供，靜態網站建置不包含這些檔案。</li></ul></div>
</section>
<aside class="appendix"><div><p class="eyebrow">EXPERIMENT APPENDIX</p><h3>自監督影像重建</h3><p>先前的 Teacher／Student 圖片是重建實驗產物，保留於附錄，與分割任務分開。</p></div><a href={base+'reconstruction/'}>查看重建附錄 →</a></aside>
</Site>
<script>
const base = import.meta.env.BASE_URL;
const get = <T extends HTMLElement>(id:string) => document.getElementById(id) as T;
const controls=get<HTMLFieldSetElement>('seg-controls');
const select=get<HTMLSelectElement>('seg-case');
const layerSelect=get<HTMLSelectElement>('seg-layer');
const mode=get<HTMLSelectElement>('mask-mode');
const visible=get<HTMLInputElement>('mask-visible');
const opacity=get<HTMLInputElement>('opacity');
const status=get('seg-status');
const content=get('seg-content');
const retry=get<HTMLButtonElement>('seg-retry');
const canvas=get<HTMLCanvasElement>('seg-canvas');
const original=get<HTMLCanvasElement>('original-canvas');
type View={id:string;label:string;width:number;height:number};
type Example=View&{images:{image:string;mask:string};prediction:null};
type Score={dice:number|null;predictedPixels:number;referencePixels:number;intersectionPixels:number};
const predictionRoles=['image','reference','prediction','processed'] as const;
type PredictionRole=typeof predictionRoles[number];
type PredictionExample=View&{images:Record<PredictionRole,string>;sha256:Record<PredictionRole,string>;before:Score;after:Score};
const layerLabels={native:'參考標註',reference:'參考標註',prediction:'封存模型預測',processed:'後處理結果'};
type Layer=keyof typeof layerLabels;
let records:Example[]=[];
let predictionRecords:PredictionExample[]|undefined;
let current:View|undefined;
let activeLayer:Layer='native';
let bitmap:ImageBitmap|undefined;
let maskPixels:Uint8ClampedArray|undefined;
function draw(){
  if(!current||!bitmap||!maskPixels)return;
  const ctx=canvas.getContext('2d')!;
  ctx.clearRect(0,0,canvas.width,canvas.height);
  const maskOnly=mode.value==='mask';
  if(maskOnly){ctx.fillStyle='#000';ctx.fillRect(0,0,canvas.width,canvas.height);}
  else ctx.drawImage(bitmap,0,0);
  const layer=new ImageData(current.width,current.height);
  if(visible.checked){
    for(let i=0;i<maskPixels.length;i+=4){
      if(maskPixels[i]===255){
        layer.data[i]=255;layer.data[i+1]=maskOnly?255:0;layer.data[i+2]=maskOnly?255:0;
        layer.data[i+3]=255;
      }
    }
    const overlay=document.createElement('canvas');overlay.width=current.width;overlay.height=current.height;
    overlay.getContext('2d')!.putImageData(layer,0,0);
    ctx.globalAlpha=maskOnly?1:Number(opacity.value)/100;ctx.drawImage(overlay,0,0);ctx.globalAlpha=1;
  }
  opacity.disabled=maskOnly||!visible.checked;
  get('opacity-value').textContent=opacity.value+'%';
  const label=layerLabels[activeLayer];
  get('mask-title').textContent=label+(maskOnly?'二值遮罩':'疊圖');
  get('mask-legend').textContent=!visible.checked?'遮罩已隱藏':maskOnly?'白色：'+label+'區域；黑色：其餘區域':'紅色：'+label+'區域';
  canvas.setAttribute('aria-label',current.label+'的'+label+(maskOnly?'二值遮罩':'紅色疊圖')+(!visible.checked?'，遮罩已隱藏':''));
}
function validScore(score:Score){
  if(!score)return false;
  const {dice,predictedPixels:p,referencePixels:r,intersectionPixels:i}=score;
  return [p,r,i].every(n=>Number.isInteger(n)&&n>=0&&n<=224*224)&&i<=Math.min(p,r)&&
    (p+r===0?dice===null:typeof dice==='number'&&Number.isFinite(dice)&&Math.abs(dice-2*i/(p+r))<1e-12);
}
function checkScore(prediction:Uint8ClampedArray,reference:Uint8ClampedArray,score:Score){
  let p=0,r=0,overlap=0;
  for(let i=0;i<prediction.length;i+=4){
    p+=Number(prediction[i]===255);r+=Number(reference[i]===255);
    overlap+=Number(prediction[i]===255&&reference[i]===255);
  }
  if(p!==score.predictedPixels||r!==score.referencePixels||overlap!==score.intersectionPixels)throw Error('metrics');
}
function binaryPixels(image:ImageBitmap){
  const mask=document.createElement('canvas');mask.width=image.width;mask.height=image.height;
  mask.getContext('2d')!.drawImage(image,0,0);
  const pixels=mask.getContext('2d')!.getImageData(0,0,image.width,image.height).data;
  for(let i=0;i<pixels.length;i+=4){
    if(![0,255].includes(pixels[i])||pixels[i]!==pixels[i+1]||pixels[i]!==pixels[i+2]||pixels[i+3]!==255)throw Error('mask encoding');
  }
  return pixels;
}
async function loadPredictions(signal:AbortSignal){
  if(predictionRecords)return predictionRecords;
  const response=await fetch(base+'demo-data/segmentation-predictions/manifest.json',{signal});
  if(!response.ok)throw Error('prediction manifest');
  const data=await response.json();
  if(data.schemaVersion!==1||data.kind!=='archived-segmentation-output'||!Array.isArray(data.cases)||data.cases.length!==3||!data.cases.every((c:PredictionExample,i:number)=>
    c.id==='seg-0'+(i+1)&&c.label===records[i].label&&c.width===224&&c.height===224&&validScore(c.before)&&validScore(c.after)&&
    predictionRoles.every(role=>c.images?.[role]===c.id+'-'+role+'.png'&&typeof c.sha256?.[role]==='string'&&/^[a-f0-9]{64}$/.test(c.sha256[role]))))throw Error('prediction schema');
  predictionRecords=data.cases;
  return predictionRecords!;
}
async function loadImages(item:View&{images:Record<string,string>;sha256?:Record<string,string>},folder:string,roles:string[],signal:AbortSignal){
  const images:ImageBitmap[]=[];
  try{
    for(const role of roles){
      const response=await fetch(base+'demo-data/'+folder+'/'+item.images[role],{signal});
      if(!response.ok)throw Error('image');
      const blob=await response.blob();
      if(item.sha256){
        const hash=Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',await blob.arrayBuffer()))).map(b=>b.toString(16).padStart(2,'0')).join('');
        if(hash!==item.sha256[role])throw Error('image hash');
      }
      const decoded=await createImageBitmap(blob);
      images.push(decoded);
      if(decoded.width!==item.width||decoded.height!==item.height)throw Error('dimensions');
    }
    return images;
  }catch(error){images.forEach(image=>image.close());throw error;}
}
async function render(){
  const item=records.find(c=>c.id===select.value);if(!item)return;
  const selectedLayer=layerSelect.value as Layer;
  controls.disabled=true;retry.hidden=true;content.hidden=true;content.setAttribute('aria-busy','true');
  status.textContent='正在載入 '+item.label+' 的影像與'+layerLabels[selectedLayer]+'…';
  const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),8000);
  let pair:ImageBitmap[]=[];
  try{
    let view:View=item;
    let pixels:Uint8ClampedArray;
    get('seg-metrics').hidden=true;
    if(selectedLayer==='native'){
      pair=await loadImages(item,'segmentation',['image','mask'],controller.signal);
      pixels=binaryPixels(pair[1]);
    }else{
      const prediction=(await loadPredictions(controller.signal)).find(c=>c.id===item.id)!;
      pair=await loadImages(prediction,'segmentation-predictions',[...predictionRoles],controller.signal);
      const masks={reference:binaryPixels(pair[1]),prediction:binaryPixels(pair[2]),processed:binaryPixels(pair[3])};
      checkScore(masks.prediction,masks.reference,prediction.before);checkScore(masks.processed,masks.reference,prediction.after);
      view=prediction;pixels=masks[selectedLayer];
      const before=prediction.before.dice,after=prediction.after.dice;
      get('prediction-dice').textContent=before===null?'不適用':before.toFixed(4);
      get('processed-dice').textContent=after===null?'不適用':after.toFixed(4);
      get('seg-observation').textContent=before===null||after===null?'空遮罩組合不計算 Dice。':after<before?'此案例 Dice 下降：移除零碎區域時，也刪除了部分正確病灶。':after>before?'此案例 Dice 上升：保留最大區域後，與參考標註的重疊比例提高。':'此案例 Dice 不變：預測已是單一連通區域，後處理未改變遮罩。';
      get('seg-metrics').hidden=false;
    }
    bitmap?.close();bitmap=pair[0];pair.slice(1).forEach(image=>image.close());pair=[];
    current=view;activeLayer=selectedLayer;maskPixels=pixels;
    original.width=canvas.width=view.width;original.height=canvas.height=view.height;
    original.getContext('2d')!.drawImage(bitmap,0,0);
    original.setAttribute('aria-label',item.label+(selectedLayer==='native'?' 的 FA 原圖':' 的 224 × 224 模型輸入'));
    get('input-title').textContent=selectedLayer==='native'?'FA 原圖':'FA 模型輸入';
    get('input-description').textContent=selectedLayer==='native'?'儲存庫中的影像，保留原始尺寸':'封存的 224 × 224 影像，與右側遮罩逐像素配對';
    draw();
    const url=new URL(location.href);url.searchParams.set('case',item.id);
    if(selectedLayer==='native')url.searchParams.delete('layer');else url.searchParams.set('layer',selectedLayer);
    history.replaceState(null,'',url);
    get<HTMLAnchorElement>('seg-link').href=url.pathname+url.search+'#pixel-comparison';
    get('dimensions').textContent=view.width+' × '+view.height+' px · '+(selectedLayer==='native'?'同尺寸原圖與標註，未重採樣配對。':'原始資料以最近鄰縮放至模型尺寸；目前顯示封存資料。');
    status.textContent=item.label+' · 已載入'+(selectedLayer==='native'?'原圖與參考標註。':layerLabels[selectedLayer]+'；顯示封存結果，非即時推論。');
    content.hidden=false;
  }catch{
    if(selectedLayer!=='native')predictionRecords=undefined;
    status.textContent='影像或遮罩未完整載入，或資料核對不符。請重試或切換其他影像／圖層。';retry.hidden=false;
  }finally{
    pair.forEach(image=>image.close());clearTimeout(timeout);controls.disabled=false;content.setAttribute('aria-busy','false');
  }
}
async function load(){
  controls.disabled=true;retry.hidden=true;
  const controller=new AbortController();const timeout=setTimeout(()=>controller.abort(),8000);
  try{
    const response=await fetch(base+'demo-data/segmentation/manifest.json',{signal:controller.signal});
    if(!response.ok)throw Error('manifest');
    const data=await response.json();
    if(!Array.isArray(data.cases)||data.cases.length!==3||!data.cases.every((c:Example,i:number)=>c.id==='seg-0'+(i+1)&&typeof c.label==='string'&&Number.isInteger(c.width)&&Number.isInteger(c.height)&&c.width>0&&c.height>0&&c.width<=4096&&c.height<=4096&&c.prediction===null&&c.images?.image===c.id+'-image.png'&&c.images?.mask===c.id+'-mask.png'))throw Error('schema');
    records=data.cases;select.replaceChildren(...records.map(c=>new Option(c.label,c.id)));
    const requested=new URL(location.href).searchParams.get('case');
    select.value=records.some(c=>c.id===requested)?requested!:'seg-01';
    const requestedLayer=new URL(location.href).searchParams.get('layer');
    layerSelect.value=requestedLayer&&Object.hasOwn(layerLabels,requestedLayer)?requestedLayer:'native';
  }catch{
    status.textContent='本機研究資料尚未提供或無法載入。研究說明仍可閱讀。';
    select.replaceChildren(new Option('資料未載入',''));retry.hidden=false;content.setAttribute('aria-busy','false');return;
  }finally{clearTimeout(timeout);}
  await render();
}
select.addEventListener('change',render);
layerSelect.addEventListener('change',render);
mode.addEventListener('change',draw);
visible.addEventListener('change',draw);
opacity.addEventListener('input',draw);
retry.addEventListener('click',()=>records.length?render():load());
get('seg-reset').addEventListener('click',async()=>{
  select.value='seg-01';layerSelect.value='native';mode.value='overlay';visible.checked=true;opacity.value='45';await render();select.focus();
});
if(import.meta.env.DEV){
  load();
}else{
  controls.disabled=true;retry.hidden=true;
  status.textContent='公開版提供研究方法與來源說明；研究影像與紅色病灶標註僅於本機展示。';
  select.replaceChildren(new Option('影像僅供本機展示',''));
  content.setAttribute('aria-busy','false');
}
</script>
<style>
.seg-viewer{scroll-margin-top:100px}.field{min-width:0;max-width:100%}.field select{max-width:100%}.scores{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:24px 0 12px}.scores>div{background:var(--tint);border-radius:8px;padding:16px}.scores dt{font-size:14px;color:var(--muted)}.scores dd{margin:4px 0 0;font-size:26px;font-weight:650;color:var(--ink);font-variant-numeric:tabular-nums}.metric-caption{font-size:14px;max-width:850px}#seg-observation{font-weight:600;color:var(--ink);margin-bottom:8px}
