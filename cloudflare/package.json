{
  "name": "cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DEMO_DB --local",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "check": "wrangler types && tsc --noEmit"
  },
  "devDependencies": { "wrangler": "4.147.0" }
}
